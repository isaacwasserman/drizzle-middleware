{
	"name": "drizzle-middleware",
	"version": "0.2.0",
	"description": "Drizzle ORM query middleware for node-postgres, in one round trip",
	"type": "module",
	"exports": {
		"./node-postgres": {
			"types": "./dist/node-postgres.d.ts",
			"import": "./dist/node-postgres.js"
		}
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"build": "tsc -p tsconfig.build.json && bun scripts/fix-beta-imports.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"files": ["dist"],
	"repository": {
		"type": "git",
		"url": "https://github.com/isaacwasserman/drizzle-middleware"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.30.0",
		"@types/bun": "latest",
		"@types/pg": "^8.23.1",
		"drizzle-orm-beta": "^1.0.0-beta.22",
		"pg": "^8.23.1",
		"typescript": "7"
	},
	"peerDependencies": {
		"drizzle-orm": ">=1.0.0-0",
		"pg": ">=8.23.0"
	}
}
