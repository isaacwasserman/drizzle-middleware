{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"isolatedDeclarations": true,
		"declaration": true,
		"allowJs": false
	},
	"include": [
		"src/core/**/*.ts",
		"src/internal/**/*.ts",
		"src/drivers/**/*.ts",
		"src/v2/**/*.ts",
		"types.test-d.ts"
	]
}
